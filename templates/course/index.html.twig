{% extends 'base.html.twig' %}

{% block title %}Cours{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des cours</h1>

        <a href="{{ path('app_course_new') }}"
           class="btn btn-primary rounded-pill">
            Nouveau cours
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                {% for course in courses %}

                    <tr>

                        <td>{{ course.id }}</td>

                        <td>{{ course.name }}</td>

                        <td class="d-flex gap-2">

                            <a href="{{ path('app_course_show', {id: course.id}) }}"
                               class="btn btn-sm btn-outline-dark">
                                Voir
                            </a>

                            <a href="{{ path('app_course_edit', {id: course.id}) }}"
                               class="btn btn-sm btn-outline-primary">
                                Modifier
                            </a>

                            <form method="post"
                                  action="{{ path('app_course_delete', {id: course.id}) }}"
                                  onsubmit="return confirm('Supprimer ce cours ?');">

                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('delete' ~ course.id) }}">

                                <button class="btn btn-sm btn-outline-danger">
                                    Supprimer
                                </button>

                            </form>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="3" class="text-center py-4">
                            Aucun cours
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}