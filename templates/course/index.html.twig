{% extends 'base.html.twig' %}

{% block title %}Cours{% endblock %}

{% block body %}

<div class="container py-5">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="h3 mb-0">Gestion des cours</h1>

        <a href="{{ path('app_course_new') }}"
           class="btn btn-primary rounded-pill px-4">
            Nouveau cours
        </a>

    </div>

    {# FLASH #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success rounded-3 shadow-sm">
            {{ message }}
        </div>
    {% endfor %}

    {# CARD TABLE #}
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nom</th>
                            <th>Description</th>
                            <th>Niveau</th>
                            <th>Prix</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for course in courses %}

                        <tr>

                            <td class="ps-4 fw-semibold">
                                {{ course.title }}
                            </td>

                            <td class="text-muted">
                                {{ course.description }}
                            </td>

                            <td>
                                <span class="badge bg-primary rounded-pill">
                                    {{ course.level }}
                                </span>
                            </td>

                            <td class="fw-semibold">
                                {{ course.price | number_format(2, ',', ' ') }} €
                            </td>

                            <td class="text-end pe-4">

                                <div class="d-flex justify-content-end gap-2">

                                    <a href="{{ path('app_course_show', {id: course.id}) }}"
                                       class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                        Voir
                                    </a>

                                    <a href="{{ path('app_course_edit', {id: course.id}) }}"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Modifier
                                    </a>

                                    <form method="post"
                                          action="{{ path('app_course_delete', {id: course.id}) }}"
                                          onsubmit="return confirm('Supprimer ce cours ?');">

                                        <input type="hidden"
                                               name="_token"
                                               value="{{ csrf_token('delete' ~ course.id) }}">

                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Supprimer
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                Aucun cours disponible
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

{% endblock %}