{% extends 'base.html.twig' %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4">

                        <h2 class="mb-4 text-center">
                            🕌 Inscription de votre enfant
                        </h2>

                        {{ form_start(form) }}

                        <div class="mb-4">
                            <h5 class="mb-2">👦 Enfants existants</h5>
                            {{ form_row(form.children) }}
                        </div>

                        <hr>

                        <div class="mb-4">
                            <h5 class="mb-2">➕ Ajouter un nouvel enfant</h5>
                            {{ form_row(form.newChild) }}
                        </div>

                        <hr>

                        <div class="mb-4">
                            <h5 class="mb-2">📝 Notes</h5>
                            {{ form_row(form.notes) }}
                        </div>

                        <button class="btn btn-success w-100 py-2 rounded-3">
                            Valider l’inscription
                        </button>

                        {{ form_end(form) }}

                    </div>
                </div>

            </div>

        </div>

    </div>

{% endblock %}
