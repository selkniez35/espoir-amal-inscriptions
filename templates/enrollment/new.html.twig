{% extends 'base.html.twig' %}

{% block title %}Inscription de votre enfant{% endblock %}

{% block body %}

    <div class="container py-5"
         data-controller="enrollment-collection"
         data-enrollment-collection-index-value="{{ form.newChildren|length > 0 ? form.newChildren|last.vars.name + 1 : 0 }}"
         data-enrollment-collection-prototype-value="{{ form_widget(form.newChildren.vars.prototype)|e('html_attr') }}">

        <div class="card shadow-sm border-0 p-4 mx-auto" style="max-width: 600px;">

            <h1 class="mb-4">Inscription de votre enfant</h1>

            {{ form_start(form) }}

            <div class="mb-4">
                {{ form_row(form.children) }}
            </div>

            <div class="mb-4" id="new-children-section" style="display: none;" data-enrollment-collection-target="section">
                <h3 class="h5 mb-3">Nouveaux enfants</h3>
                <ul class="newChildren list-unstyled" data-enrollment-collection-target="collectionHolder">
                    {% for child in form.newChildren %}
                        <li class="border rounded p-3 mb-3 bg-light position-relative">
                            {{ form_widget(child) }}
                            <button type="button"
                                    class="btn-close position-absolute top-0 end-0 m-2 remove-child"
                                    aria-label="Close"
                                    data-action="click->enrollment-collection#remove"></button>
                        </li>
                    {% endfor %}
                </ul>

                <button type="button" class="add_item_link btn btn-outline-secondary btn-sm" data-action="click->enrollment-collection#add">
                    <i class="bi bi-plus-circle"></i> Ajouter un autre enfant
                </button>
            </div>

            <div class="mb-4" id="add-child-prompt" data-enrollment-collection-target="prompt">
                <button type="button" class="btn btn-link p-0 text-decoration-none" data-action="click->enrollment-collection#showNewChildForm">
                    <i class="bi bi-plus-lg"></i> Ajouter un nouvel enfant (non listé ci-dessus)
                </button>
            </div>

            <div class="mb-4 border-top pt-3">
                {{ form_row(form.notes) }}
            </div>

            <button class="btn btn-primary mt-3 w-100">
                Enregistrer le dossier
            </button>

            {{ form_end(form) }}
        </div>

    </div>

{% endblock %}
