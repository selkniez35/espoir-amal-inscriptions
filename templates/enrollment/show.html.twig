{% extends 'base.html.twig' %}

{% block title %}Détails inscription{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-md-8 col-lg-6">

                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <h3 class="mb-0">📄 Détails inscription</h3>

                            <span class="badge bg-primary">
                            {{ enrollment.status.label() }}
                        </span>

                        </div>

                        <div class="list-group list-group-flush">

                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">ID</span>
                                <span class="fw-semibold">{{ enrollment.id }}</span>
                            </div>

                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Statut</span>
                                <span class="fw-semibold">
                                {{ enrollment.status.label() }}
                            </span>
                            </div>

                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Créée le</span>
                                <span class="fw-semibold">
                                {{ enrollment.createAt ? enrollment.createAt|date('d/m/Y H:i') : '-' }}
                            </span>
                            </div>

                            <div class="list-group-item">
                                <div class="text-muted mb-1">Notes</div>
                                    <div>
                                        {{ enrollment.notes ?: 'Aucune note' }}
                                    </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
