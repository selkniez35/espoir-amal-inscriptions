{{ form_start(form) }}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <h4 class="mb-3">Inscription</h4>

        {{ form_row(form.child) }}
        {{ form_row(form.season) }}
        {{ form_row(form.notes) }}

        <hr>

        <h4 class="mb-3">Contacts d’urgence</h4>

        {% for contact in form.emergencyContacts %}

            <div class="border rounded p-3 mb-3">

                <div class="row g-2">
                    <div class="col-md-6">
                        {{ form_row(contact.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(contact.lastName) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(contact.phone) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(contact.email) }}
                    </div>

                    <div class="col-md-12">
                        {{ form_row(contact.type) }}
                    </div>
                </div>

            </div>

        {% endfor %}

        <button class="btn btn-success w-100">
            Valider l’inscription
        </button>

    </div>
</div>

{{ form_end(form) }}
