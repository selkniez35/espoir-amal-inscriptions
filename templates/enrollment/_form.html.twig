{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <div class="row g-3">
        <div class="col-md-12">
            <div class="form-floating mb-3">
                {{ form_widget(form.child) }}
                {{ form_label(form.child) }}
                {{ form_errors(form.child) }}
            </div>
        </div>

        {#
            <div class="col-md-12">
                <div class="form-floating mb-3">
                    {{ form_widget(form.status) }}
                    {{ form_label(form.status) }}
                    {{ form_errors(form.status) }}
                </div>
            </div>
        #}

        <div class="col-md-12">
            <div class="mb-3">
                {{ form_label(form.notes, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.notes) }}
                {{ form_errors(form.notes) }}
            </div>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-success btn-lg rounded-pill shadow-sm">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer l\'inscription') }}
        </button>
    </div>

{{ form_end(form) }}
