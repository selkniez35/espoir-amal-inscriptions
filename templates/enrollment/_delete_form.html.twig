<form method="post" action="{{ path('app_enrollment_delete', {'id': enrollment.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette inscription ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enrollment.id) }}">
    <button class="btn btn-outline-danger rounded-pill px-4">
        <i class="fas fa-trash-alt me-2"></i>Supprimer
    </button>
</form>
