{% extends 'base.html.twig' %}

{% block title %}Administration - Mosquée Espoir Amal{% endblock %}

{% block body %}

    <audio autoplay loop>
        <source src="{{ asset('audio/adhan.mp3') }}" type="audio/mpeg">
        Votre navigateur ne supporte pas l’audio.
    </audio>

    <section class="bg-success bg-gradient text-white py-5">
        <div class="container text-center py-5">

            <h1 class="display-4 fw-bold mb-3">
                ⚙️ Administration
            </h1>

            <p class="lead mb-0">
                Gestion des inscriptions, des élèves et des utilisateurs.
            </p>

        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Vue d'ensemble</h2>
                <p class="text-muted">Tableau de bord de la mosquée</p>
            </div>

            <div class="row g-4">

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-2">👨‍🎓</div>
                            <h2 class="fw-bold text-success mb-0">{{ totalChildren }}</h2>
                            <p class="text-muted mb-0">Élèves</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-2">📝</div>
                            <h2 class="fw-bold text-success mb-0">{{ totalEnrollments }}</h2>
                            <p class="text-muted mb-0">Inscriptions</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-2">⏳</div>
                            <h2 class="fw-bold text-warning mb-0">{{ pendingEnrollments }}</h2>
                            <p class="text-muted mb-0">En attente</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-2">👥</div>
                            <h2 class="fw-bold text-primary mb-0">{{ totalUsers }}</h2>
                            <p class="text-muted mb-0">Utilisateurs</p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row g-4 mt-1">

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-2">✅</div>
                            <h2 class="fw-bold text-success mb-0">{{ validatedEnrollments }}</h2>
                            <p class="text-muted mb-0">Validées</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-2">❌</div>
                            <h2 class="fw-bold text-danger mb-0">{{ rejectedEnrollments }}</h2>
                            <p class="text-muted mb-0">Rejetées</p>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <section class="bg-light py-5">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Accès rapide</h2>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <a href="{{ path('app_enrollment_index') }}" class="text-decoration-none">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body text-center p-4">
                                <div class="fs-1 mb-2">📝</div>
                                <h4 class="fw-bold text-dark">Inscriptions</h4>
                                <p class="text-muted mb-0">Gérer les demandes</p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="{{ path('app_child_index') }}" class="text-decoration-none">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body text-center p-4">
                                <div class="fs-1 mb-2">👨‍🎓</div>
                                <h4 class="fw-bold text-dark">Élèves</h4>
                                <p class="text-muted mb-0">Consulter les élèves</p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="{{ path('app_user_index') }}" class="text-decoration-none">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body text-center p-4">
                                <div class="fs-1 mb-2">👥</div>
                                <h4 class="fw-bold text-dark">Utilisateurs</h4>
                                <p class="text-muted mb-0">Gérer les comptes</p>
                            </div>
                        </div>
                    </a>
                </div>

            </div>

        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-4">Dernières inscriptions</h3>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                            <tr>
                                <th>Elève</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                            </thead>

                            <tbody>
                            {% for enrollment in latestEnrollments %}
                                <tr>
                                    <td>
                                        {{ enrollment.child ? enrollment.child.fullName : '—' }}
                                    </td>

                                    <td>
                                        {{ enrollment.createAt|date('d/m/Y') }}
                                    </td>

                                    <td>
                                        {% if enrollment.status.value == 'PENDING' %}
                                            <span class="badge bg-warning">En attente</span>
                                        {% elseif enrollment.status.value == 'VALIDATED' %}
                                            <span class="badge bg-success">Validée</span>
                                        {% else %}
                                            <span class="badge bg-danger">Rejetée</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-end">
                                        <a href="{{ path('app_enrollment_show', {'id': enrollment.id}) }}"
                                           class="btn btn-sm btn-outline-success">
                                            Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

        </div>
    </section>

{% endblock %}
