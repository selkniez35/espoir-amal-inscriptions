{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin Mosquée{% endblock %}

{% block body %}

    <div class="container py-5">

        <h1 class="mb-4">🕌 Dashboard Admin - Mosquée Esprit Amal</h1>

        <div class="row g-4">

            {# USERS #}
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                    <h6 class="text-muted">Utilisateurs</h6>
                    <h2 class="fw-bold text-primary">{{ totalUsers }}</h2>
                </div>
            </div>

            {# CHILDREN #}
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                    <h6 class="text-muted">Enfants</h6>
                    <h2 class="fw-bold text-success">{{ totalChildren }}</h2>
                </div>
            </div>

            {# ENROLLMENTS #}
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                    <h6 class="text-muted">Inscriptions</h6>
                    <h2 class="fw-bold text-dark">{{ totalEnrollments }}</h2>
                </div>
            </div>

            {# PENDING #}
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                    <h6 class="text-muted">En attente</h6>
                    <h2 class="fw-bold text-warning">{{ pendingEnrollments }}</h2>
                </div>
            </div>

        </div>

        <div class="row g-4 mt-2">

            {# VALIDATED #}
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <h5>✔ Inscriptions validées</h5>
                    <h2 class="text-success">{{ validatedEnrollments }}</h2>
                    <p class="text-muted mb-0">Inscriptions confirmées par l'administration</p>
                </div>
            </div>

            {# QUICK ACTIONS #}
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-4 p-4">

                    <h5>⚡ Actions rapides</h5>

                    <div class="d-grid gap-2 mt-3">

                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-primary">
                            Gérer les utilisateurs
                        </a>

                        <a href="{{ path('app_enrollment_index') }}" class="btn btn-outline-success">
                            Voir les inscriptions
                        </a>

                        <a href="{{ path('app_user_new') }}" class="btn btn-primary">
                            + Ajouter un utilisateur
                        </a>

                    </div>

                </div>
            </div>

        </div>

    </div>

{% endblock %}
