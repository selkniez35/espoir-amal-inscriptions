{% extends 'base.html.twig' %}

{% block title %}Création de votre compte{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">Création de compte</h2>

                    <p class="text-center text-muted mb-4">
                        Créer votre compte pour inscrire votre enfant facilement
                    </p>

                    {{ form_start(registrationForm) }}

                        {# PRÉNOM #}
                        {{ form_row(registrationForm.firstName) }}

                        {# NOM #}
                        {{ form_row(registrationForm.lastName) }}

                        {# EMAIL #}
                        {{ form_row(registrationForm.email, {
                            label: 'Email'
                        }) }}

                        {# TÉLÉPHONE #}
                        {{ form_row(registrationForm.phoneNumber) }}

                        {# ADRESSE #}
                        {{ form_row(registrationForm.address) }}

                        {# MOT DE PASSE #}
                        {{ form_row(registrationForm.plainPassword, {
                            label: 'Mot de passe'
                        }) }}

                        {# AGREE TERMS (IMPORTANT) #}
                        <div class="form-check mb-3">
                           {{ form_row(registrationForm.agreeTerms, {
                                label: "J'accepte les conditions d'utilisation"
                            }) }}
                        </div>

                        {# SUBMIT #}
                        <button type="submit" class="btn btn-primary w-100 py-2 mt-2">
                            Créer mon compte
                        </button>

                    {{ form_end(registrationForm) }}

                    <hr class="my-4">

                    <p class="text-center text-muted small">
                        Déjà un compte ?
                        <a href="{{ path('app_login') }}">Se connecter</a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
