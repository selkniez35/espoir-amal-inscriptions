{% extends 'base.html.twig' %}

{% block title %}Détails de l'élève{% endblock %}

{% block body %}
<div class="container py-5">
    <h1>Élève : {{ child.firstName }} {{ child.lastName }}</h1>
    <p>Niveau : {{ child.level }}</p>
    <a href="{{ path('app_child_index') }}" class="btn btn-secondary">Retour à la liste</a>
</div>
{% endblock %}
