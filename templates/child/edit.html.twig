{% extends 'base.html.twig' %}

{% block title %}Modifier enfant{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-md-6">

                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4">

                        <h3 class="mb-4">✏️ Modifier enfant</h3>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_row(form.firstName) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.lastName) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.birthday) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.level) }}
                        </div>

                        <button class="btn btn-primary w-100">
                            Enregistrer
                        </button>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
